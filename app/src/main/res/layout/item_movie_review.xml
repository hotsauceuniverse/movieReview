<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >

        <ImageView
            android:id="@+id/review_img"
            android:layout_width="110dp"
            android:layout_height="140dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginLeft="15dp"
            android:src="@drawable/ic_launcher_background"
            android:scaleType="fitXY"
            />

        <TextView
            android:id="@+id/review_title"
            android:layout_width="230dp"
            android:layout_height="20dp"
            app:layout_constraintStart_toEndOf="@+id/review_img"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="15dp"
            android:text="21231231241adaoiusadouahsdouahosdjhaosudaosdouahsd"
            android:textSize="16dp"
            android:textColor="@color/black"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:ellipsize="end"
            />

        <RatingBar
            android:id="@+id/ratingBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="?android:attr/ratingBarStyleSmall"
            android:layout_marginRight="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/review_title"
            android:progressBackgroundTint="#CCCCCC"
            android:progressTint="#FFD700"
            android:secondaryProgressTint="#FFD700"
            />

        <TextView
            android:id="@+id/review_content"
            android:layout_width="230dp"
            android:layout_height="80dp"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="4"
            android:text="daidwdwdasdasfasdashgjjhhjaojiwasdaiojwdaiojdwaojidwaojidawiojwdajiodwaojiwdiojiojdawijowdaiojwdaijowdjiowdajiwadjiowadijowdajiowdaojiwdajiowdjiowdajiowadjiowdajdwajwdajwji"
            android:textColor="@color/black"
            android:textSize="14dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/review_img"
            app:layout_constraintTop_toBottomOf="@+id/ratingBar"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>